# Supabase Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# JWT Auth Settings
JWT_SECRET_KEY=change_this_to_a_very_secret_random_string_12345
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# External LLM Settings (NFR-04, NFR-14)
# Providers: openai | groq | openrouter | gemini
# Groq: LLM_API_KEY from https://console.groq.com/keys
LLM_API_KEY=your_llm_provider_api_key
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_ENABLED=true

# App Settings
ENVIRONMENT=development
MEDICAL_DISCLAIMER="Prototype only. Not professional medical advice."