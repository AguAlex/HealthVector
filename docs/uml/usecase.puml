@startuml
left to right direction
skinparam packageStyle rectangle

actor "Patient (User)" as User

rectangle "Patient Medication Assistant System" {
  usecase "UC1: Manage Medication List\n(Add / Remove Drug)" as UC1
  usecase "UC2: View Daily Schedule Timeline" as UC2
  usecase "UC3: Track Dose Status\n(Mark Taken / Missed)" as UC3
  usecase "UC4: Ask Leaflet Q&A (RAG Chat)" as UC4
  usecase "UC5: Check Drug Interactions" as UC5
  usecase "UC6: View Drug Side Effects" as UC6
  usecase "UC7: Export Schedule to Plain Text" as UC7
  usecase "UC8: Reset Dashboard Data" as UC8
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC6
User --> UC7
User --> UC8

UC1 ..> UC5 : <<include>>
UC4 ..> UC6 : <<extend>>
@enduml